# ==============================================================================
# PresenceCV — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your project values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Required for Frontend)
# ------------------------------------------------------------------------------
# All frontend-accessible variables MUST be prefixed with VITE_
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_ID=                    # Optional: Non-default Firestore Database ID

# ------------------------------------------------------------------------------
# 2. AI Features Configuration (Required for AI Resume Import)
# ------------------------------------------------------------------------------
# Server-side only (Vercel Serverless Function / Express API server)
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 3. Security & Admin Configuration (Required for Serverless Admin SDK)
# ------------------------------------------------------------------------------
# Stringified JSON of your Firebase Admin Service Account Key
FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------------------------
# 4. AI-Import Quota (Required in production: without it every AI import is refused)
# ------------------------------------------------------------------------------
# Upstash Redis for the per-account AI-import quota (5 per 24 hours, src/utils/aiQuota.ts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 5. Firebase App Check & Security (Optional)
# ------------------------------------------------------------------------------
# Google reCAPTCHA v3 Site Key for Firebase App Check.
# Optional: If omitted, Firebase App Check is safely bypassed in development/production.
VITE_RECAPTCHA_SITE_KEY=
